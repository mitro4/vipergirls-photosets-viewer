# Forum credentials (optional — enables member-only threads)
# Password must be MD5-hashed (vBulletin sends md5(password)).
VIPER_USERNAME=
VIPER_PASSWORD_MD5=

# Rate limit: requests/sec to forum & viper.click (token bucket)
VIPER_REQUEST_LIMIT=2

# ── Seeds for the runtime settings table ─────────────────────────────
# Each is applied ONCE — when the key is absent from the DB (first boot);
# after that the value set via the UI wins and the env var is ignored.
#VIPER_DOWNLOAD_CONCURRENCY=8
#VIPER_THREAD_CONCURRENCY=2
#VIPER_DOWNLOAD_TIMEOUT=30
#VIPER_MAX_RETRIES=3
# On-disk image-cache LRU trim ceiling, GB (0 = unlimited)
#VIPER_CACHE_LIMIT_GB=0
